{
  "name": "duho-tech-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "next typegen && tsc --noEmit",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "pnpm content:validate && next build --webpack",
    "qa:web": "node --import tsx scripts/check-web.ts",
    "public:package": "node --import tsx scripts/package-public.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "zod": "^4.0.0",
    "mermaid": "^11.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "@fontsource/noto-sans-kr": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "playwright": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0"
  },
  "type": "module"
}
